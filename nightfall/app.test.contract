test "opening splash shows the title and loading state"
  expect text "title" == "NIGHTFALL"
  expect tree has "loading-track"
  expect tree has "loading-fill"
  expect tree missing "play"

test "guard absorbs a rival attack"
  clock +1400
  expect tree has "fireboy-fighter"
  tap "strike"
  expect state rivalHealth == 88
  expect state hype == 9
  tap "guard"
  tap "enemy-strike"
  expect state playerHealth == 100
  expect state hype == 17
  tap "guard"
  tap "enemy-strike"
  expect state playerHealth == 90

test "hype unlocks a special and ends the round"
  clock +1400
  tap "strike"
  tap "strike"
  tap "strike"
  tap "strike"
  tap "kick"
  expect state rivalHealth == 34
  expect state hype == 50
  tap "special"
  expect state rivalHealth == 0
  expect state hype == 0
  expect text "result" == "VICTORY"

test "reset starts a fresh fight"
  clock +1400
  tap "enemy-strike"
  tap "restart"
  expect state playerHealth == 100
  expect state rivalHealth == 100
  expect state hype == 0
